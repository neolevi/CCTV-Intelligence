# CCTV Intelligence Configuration
APP_NAME="CCTV Intelligence"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./cctv_intelligence.db"
SYNC_DATABASE_URL="sqlite:///./cctv_intelligence.db"

# Storage
STORAGE_DIR="./storage"
RECORDINGS_DIR="./storage/recordings"
FRAMES_DIR="./storage/frames"
THUMBNAILS_DIR="./storage/thumbnails"
SUMMARIES_DIR="./storage/summaries"
STORAGE_RETENTION_DAYS=30

# Camera
DEFAULT_CAMERA_INDEX=0
DEFAULT_FRAME_WIDTH=640
DEFAULT_FRAME_HEIGHT=480
DEFAULT_CAMERA_FPS=30

# Motion Detection
MOTION_SENSITIVITY=25
MOTION_THRESHOLD_PERCENT=1.5
IDLE_TIMEOUT_SECONDS=5.0
DEEP_IDLE_TIMEOUT_SECONDS=20.0

# Adaptive Sampling Rates (FPS)
ACTIVE_SAMPLING_FPS=5.0
IDLE_SAMPLING_FPS=2.0
DEEP_IDLE_SAMPLING_FPS=1.0
